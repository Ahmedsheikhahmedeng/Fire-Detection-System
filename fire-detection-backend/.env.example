# Application
APP_NAME=Fire Detection API
APP_ENV=development
APP_VERSION=v3
DEBUG=true

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Database - Local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fire_detection
DB_USER=fire_user
DB_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://fire_user:replace_with_strong_database_password@localhost:5432/fire_detection

# Database - Docker note:
# Inside Docker Compose, DB_HOST should be postgres:
# DATABASE_URL=postgresql://fire_user:replace_with_strong_database_password@postgres:5432/fire_detection

# Security
API_KEY=replace_with_strong_backend_api_key

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.example
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Scheduler
ENABLE_SCHEDULER=false
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=30

# External APIs
NASA_API_KEY=replace_with_nasa_firms_api_key
NASA_FIRMS_API_KEY=replace_with_nasa_firms_api_key
OPENWEATHER_API_KEY=replace_with_openweather_api_key

# Telegram alerts
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
ALERT_MIN_RISK_LEVEL=HIGH

# Email alerts - Gmail SMTP app password kullan
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_gmail_address@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password
SMTP_FROM_EMAIL=replace_with_gmail_address@gmail.com
ALERT_EMAIL_TO=recipient1@example.com,recipient2@example.com

# Tests
TEST_DATABASE_URL=postgresql://fire_user:replace_with_test_database_password@localhost:5432/fire_detection_test

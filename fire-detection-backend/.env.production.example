APP_ENV=production

DATABASE_URL=postgresql://fire_user:fire_password@db:5432/fire_db

NASA_API_KEY=your_nasa_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
API_KEY=your_long_random_secure_api_key

ALLOWED_ORIGINS=https://your-frontend-domain.com

ENABLE_ML_PREDICTION=true
ENABLE_V3_PREDICTION_ON_NASA_FETCH=true
V3_MAX_PREDICTIONS_PER_NASA_FETCH=100
V3_MODEL_DIR=app/ml/final_models_v3

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ALERT_MIN_RISK_LEVEL=HIGH

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=alerts@your-domain.com
ALERT_EMAIL_TO=ops@your-domain.com

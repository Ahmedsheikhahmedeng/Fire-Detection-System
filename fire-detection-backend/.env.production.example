# Production environment example for docker-compose.prod.yml
# Copy to a secure environment file or export these variables in the deployment platform.

APP_NAME=Fire Detection API
APP_VERSION=v3

DB_NAME=fire_detection
DB_USER=fire_user
DB_PASSWORD=replace_with_strong_database_password

API_KEY=replace_with_strong_backend_api_key
FRONTEND_URL=https://your-frontend-domain.example
ALLOWED_ORIGINS=https://your-frontend-domain.example
BACKEND_PORT=8000
FRONTEND_PORT=80
VITE_API_BASE_URL=https://your-backend-domain.example

ENABLE_ML_PREDICTION=true
ENABLE_V3_PREDICTION_ON_NASA_FETCH=true
V3_MAX_PREDICTIONS_PER_NASA_FETCH=100
V3_MODEL_DIR=app/ml/final_models_v3

NASA_API_KEY=replace_with_nasa_firms_api_key
OPENWEATHER_API_KEY=replace_with_openweather_api_key

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
ALERT_MIN_RISK_LEVEL=HIGH

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_gmail_address@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password
SMTP_FROM_EMAIL=replace_with_gmail_address@gmail.com
ALERT_EMAIL_TO=recipient1@example.com,recipient2@example.com
